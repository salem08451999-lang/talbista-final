generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        Int      @id @default(autoincrement())
  phone     String   @unique
  password  String
  createdAt DateTime @default(now())
  name      String?
  role      String   @default("CUSTOMER")
  active    Int      @default(1)
  photo     String?
}
