{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "talbista-final",
  "main": ".open-next/worker.js",
  "upload_source_maps": true,
  "compatibility_date": "2025-10-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "talbista-auth",
      "database_id": "1fe0aafc-ebc9-4235-8f4f-17bc90d355e6"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "talbista-final"
    }
  ],
  "observability": {
    "enabled": true
  }
}
